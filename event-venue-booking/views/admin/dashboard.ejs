<div class="page-header">
  <div>
    <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
    <p class="page-subtitle">Overview of your Event & Venue Management System</p>
  </div>
</div>

<!-- Stats Grid -->
<div class="stats-grid stats-grid-4">
  <div class="stat-card stat-blue">
    <div class="stat-icon"><i class="fas fa-building"></i></div>
    <div class="stat-info">
      <h3><%= totalVenues %></h3>
      <p>Total Venues</p>
    </div>
  </div>
  <div class="stat-card stat-green">
    <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
    <div class="stat-info">
      <h3><%= activeVenues %></h3>
      <p>Active Venues</p>
    </div>
  </div>
  <div class="stat-card stat-amber">
    <div class="stat-icon"><i class="fas fa-clock"></i></div>
    <div class="stat-info">
      <h3><%= pendingRequests %></h3>
      <p>Pending Requests</p>
    </div>
  </div>
  <div class="stat-card stat-purple">
    <div class="stat-icon"><i class="fas fa-calendar-day"></i></div>
    <div class="stat-info">
      <h3><%= todaysEvents.length %></h3>
      <p>Today's Events</p>
    </div>
  </div>
  <div class="stat-card stat-teal">
    <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
    <div class="stat-info">
      <h3><%= upcomingEventsCount %></h3>
      <p>Upcoming Events</p>
    </div>
  </div>
  <div class="stat-card stat-indigo">
    <div class="stat-icon"><i class="fas fa-check-double"></i></div>
    <div class="stat-info">
      <h3><%= completedEvents %></h3>
      <p>Completed</p>
    </div>
  </div>
  <div class="stat-card stat-red">
    <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
    <div class="stat-info">
      <h3><%= cancelledEvents %></h3>
      <p>Cancelled</p>
    </div>
  </div>
  <div class="stat-card stat-emerald">
    <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
    <div class="stat-info">
      <h3>₹<%= totalRevenue.toLocaleString('en-IN') %></h3>
      <p>Total Revenue</p>
    </div>
  </div>
</div>

<!-- Today's Events -->
<div class="section-card">
  <div class="section-header">
    <h2><i class="fas fa-calendar-day"></i> Today's Events</h2>
    <a href="/admin/bookings" class="btn btn-outline btn-sm">View All Bookings</a>
  </div>
  <% if (todaysEvents.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Venue</th>
            <th>Organiser</th>
            <th>Start</th>
            <th>End</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% todaysEvents.forEach(event => { %>
            <tr>
              <td><strong><%= event.eventName %></strong></td>
              <td><%= event.venue ? event.venue.name : 'N/A' %></td>
              <td><%= event.organiser ? event.organiser.name : 'N/A' %></td>
              <td><%= event.startTime %></td>
              <td><%= event.endTime %></td>
              <td><span class="status-badge status-<%= event.status %>"><%= event.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state-inline">
      <i class="fas fa-calendar-times"></i>
      <p>No events scheduled for today.</p>
    </div>
  <% } %>
</div>

<!-- Revenue & Utilisation Row -->
<div class="dashboard-row">
  <!-- Monthly Revenue -->
  <div class="section-card">
    <h2><i class="fas fa-chart-bar"></i> Monthly Revenue</h2>
    <% if (monthlyRevenue.length > 0) { %>
      <div class="chart-container" id="revenue-chart">
        <% const maxRevenue = Math.max(...monthlyRevenue.map(m => m.total)); %>
        <% monthlyRevenue.slice(0, 6).reverse().forEach(m => { %>
          <div class="chart-bar-group">
            <div class="chart-bar-wrapper">
              <div class="chart-bar" style="height: <%= maxRevenue > 0 ? (m.total / maxRevenue * 100) : 0 %>%" title="₹<%= m.total.toLocaleString('en-IN') %>">
                <span class="chart-bar-value">₹<%= m.total >= 1000 ? (m.total / 1000).toFixed(1) + 'K' : m.total %></span>
              </div>
            </div>
            <span class="chart-label"><%= m.month %></span>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state-inline">
        <i class="fas fa-chart-bar"></i>
        <p>No revenue data yet.</p>
      </div>
    <% } %>
  </div>

  <!-- Revenue by Venue -->
  <div class="section-card">
    <h2><i class="fas fa-building"></i> Revenue by Venue</h2>
    <% if (revenueByVenue.length > 0) { %>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Venue</th>
              <th>Bookings</th>
              <th>Revenue</th>
            </tr>
          </thead>
          <tbody>
            <% revenueByVenue.forEach(r => { %>
              <tr>
                <td><strong><%= r.venueName %></strong></td>
                <td><%= r.count %></td>
                <td>₹<%= r.total.toLocaleString('en-IN') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state-inline">
        <p>No revenue data yet.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Venue Utilisation -->
<div class="section-card">
  <div class="section-header">
    <h2><i class="fas fa-chart-pie"></i> Venue Utilisation (This Month)</h2>
  </div>
  <% if (utilisationData.length > 0) { %>
    <div class="utilisation-grid">
      <% utilisationData.forEach(venue => { %>
        <div class="utilisation-card">
          <div class="utilisation-header">
            <h4><%= venue.name %></h4>
            <span class="utilisation-percent"><%= venue.utilisation %>%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= venue.utilisation %>%"
              data-color="<%= venue.utilisation > 70 ? 'high' : (venue.utilisation > 40 ? 'medium' : 'low') %>">
            </div>
          </div>
          <div class="utilisation-meta">
            <span>Booked: <%= venue.bookedHours %>hrs</span>
            <span>Available: <%= venue.availableHours %>hrs</span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state-inline">
      <p>No venue utilisation data.</p>
    </div>
  <% } %>
</div>
