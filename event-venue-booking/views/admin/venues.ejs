<div class="page-header">
  <div>
    <h1><i class="fas fa-building"></i> Manage Venues</h1>
    <p class="page-subtitle">Add, edit, and manage your venues</p>
  </div>
  <a href="/admin/venues/new" class="btn btn-primary">
    <i class="fas fa-plus"></i> Add Venue
  </a>
</div>

<% if (venues.length > 0) { %>
  <div class="table-responsive section-card">
    <table class="data-table" id="venues-table">
      <thead>
        <tr>
          <th>Venue</th>
          <th>Location</th>
          <th>Capacity</th>
          <th>Rate/hr</th>
          <th>Facilities</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% venues.forEach(venue => { %>
          <tr>
            <td>
              <div class="table-venue-name">
                <strong><%= venue.name %></strong>
              </div>
            </td>
            <td><%= venue.location %></td>
            <td><%= venue.capacity %></td>
            <td>₹<%= venue.hourlyRate.toLocaleString('en-IN') %></td>
            <td>
              <div class="table-facilities">
                <% venue.facilities.slice(0, 2).forEach(f => { %>
                  <span class="facility-tag-sm"><%= f %></span>
                <% }) %>
                <% if (venue.facilities.length > 2) { %>
                  <span class="facility-tag-sm facility-more">+<%= venue.facilities.length - 2 %></span>
                <% } %>
              </div>
            </td>
            <td><span class="status-badge status-<%= venue.status %>"><%= venue.status %></span></td>
            <td>
              <div class="action-buttons">
                <a href="/admin/venues/<%= venue._id %>/edit" class="btn btn-outline btn-sm" title="Edit">
                  <i class="fas fa-edit"></i>
                </a>
                <form action="/admin/venues/<%= venue._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete/deactivate this venue?')">
                  <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="empty-state">
    <i class="fas fa-building"></i>
    <h3>No venues yet</h3>
    <p>Get started by adding your first venue.</p>
    <a href="/admin/venues/new" class="btn btn-primary">Add Venue</a>
  </div>
<% } %>
