<div class="page-header">
  <div>
    <h1><i class="fas fa-ban"></i> Venue Blocks</h1>
    <p class="page-subtitle">Block venues for maintenance, renovation, or special purposes</p>
  </div>
</div>

<!-- Add Block Form -->
<div class="section-card">
  <h2><i class="fas fa-plus-circle"></i> Create New Block</h2>
  <form action="/admin/blocks" method="POST" class="block-form">
    <div class="form-row form-row-4">
      <div class="form-group">
        <label for="venue"><i class="fas fa-building"></i> Venue *</label>
        <select id="venue" name="venue" required>
          <option value="">Select Venue</option>
          <% venues.forEach(v => { %>
            <option value="<%= v._id %>"><%= v.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="startDateTime"><i class="fas fa-clock"></i> Start Date/Time *</label>
        <input type="datetime-local" id="startDateTime" name="startDateTime" required>
      </div>
      <div class="form-group">
        <label for="endDateTime"><i class="fas fa-clock"></i> End Date/Time *</label>
        <input type="datetime-local" id="endDateTime" name="endDateTime" required>
      </div>
      <div class="form-group">
        <label for="reason"><i class="fas fa-comment"></i> Reason *</label>
        <select id="reason" name="reason" required>
          <option value="">Select Reason</option>
          <option value="Maintenance">Maintenance</option>
          <option value="Renovation">Renovation</option>
          <option value="College Event">College Event</option>
          <option value="Private Use">Private Use</option>
          <option value="Other">Other</option>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">
      <i class="fas fa-lock"></i> Create Block
    </button>
  </form>
</div>

<!-- Existing Blocks -->
<div class="section-card">
  <h2><i class="fas fa-list"></i> Existing Blocks</h2>
  <% if (blocks.length > 0) { %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Venue</th>
            <th>Start</th>
            <th>End</th>
            <th>Reason</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% blocks.forEach(block => { %>
            <tr class="<%= new Date(block.endDateTime) < new Date() ? 'row-expired' : '' %>">
              <td><strong><%= block.venue ? block.venue.name : 'Deleted' %></strong></td>
              <td><%= new Date(block.startDateTime).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td><%= new Date(block.endDateTime).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td><span class="reason-badge"><%= block.reason %></span></td>
              <td><%= new Date(block.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></td>
              <td>
                <form action="/admin/blocks/<%= block._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Remove this block?')">
                  <button type="submit" class="btn btn-danger btn-sm" title="Remove">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state-inline">
      <i class="fas fa-ban"></i>
      <p>No venue blocks created yet.</p>
    </div>
  <% } %>
</div>
