<div class="page-header">
  <div>
    <a href="/admin/venues" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back to Venues</a>
    <h1><i class="fas fa-<%= editing ? 'edit' : 'plus' %>"></i> <%= editing ? 'Edit' : 'Add New' %> Venue</h1>
  </div>
</div>

<div class="section-card form-card">
  <form action="<%= editing ? '/admin/venues/' + venue._id + '/edit' : '/admin/venues' %>" method="POST" class="venue-form">
    <div class="form-group">
      <label for="name"><i class="fas fa-building"></i> Venue Name *</label>
      <input type="text" id="name" name="name" placeholder="e.g. Grand Auditorium" required maxlength="200"
        value="<%= editing ? venue.name : '' %>">
    </div>

    <div class="form-group">
      <label for="description"><i class="fas fa-align-left"></i> Description *</label>
      <textarea id="description" name="description" rows="4" placeholder="Describe the venue..." required maxlength="2000"><%= editing ? venue.description : '' %></textarea>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="capacity"><i class="fas fa-users"></i> Capacity *</label>
        <input type="number" id="capacity" name="capacity" min="1" placeholder="e.g. 500" required
          value="<%= editing ? venue.capacity : '' %>">
      </div>
      <div class="form-group">
        <label for="hourlyRate"><i class="fas fa-rupee-sign"></i> Hourly Rate (₹) *</label>
        <input type="number" id="hourlyRate" name="hourlyRate" min="0" step="0.01" placeholder="e.g. 2000" required
          value="<%= editing ? venue.hourlyRate : '' %>">
      </div>
    </div>

    <div class="form-group">
      <label for="location"><i class="fas fa-map-marker-alt"></i> Location *</label>
      <input type="text" id="location" name="location" placeholder="e.g. Main Campus, Block A" required
        value="<%= editing ? venue.location : '' %>">
    </div>

    <div class="form-group">
      <label><i class="fas fa-cogs"></i> Facilities</label>
      <div class="checkbox-grid" id="facilities-grid">
        <%
          const facilityOptions = ['Projector', 'WiFi', 'Air Conditioning', 'Sound System', 'Stage', 'Parking', 'Whiteboard', 'Power Backup', 'Catering', 'Green Room', 'CCTV', 'Wheelchair Access'];
          const selectedFacilities = editing ? venue.facilities : [];
        %>
        <% facilityOptions.forEach(f => { %>
          <label class="checkbox-label">
            <input type="checkbox" name="facilities" value="<%= f %>"
              <%= selectedFacilities.includes(f) ? 'checked' : '' %>>
            <span class="checkbox-custom"></span>
            <%= f %>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="form-group">
      <label for="imageUrl"><i class="fas fa-image"></i> Image URL</label>
      <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg"
        value="<%= editing ? venue.imageUrl : '' %>">
      <small class="form-hint">Leave blank for default image</small>
    </div>

    <div class="form-group">
      <label for="status"><i class="fas fa-toggle-on"></i> Status</label>
      <select id="status" name="status">
        <option value="active" <%= editing && venue.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="inactive" <%= editing && venue.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary btn-lg">
        <i class="fas fa-save"></i> <%= editing ? 'Update' : 'Create' %> Venue
      </button>
      <a href="/admin/venues" class="btn btn-outline btn-lg">Cancel</a>
    </div>
  </form>
</div>
