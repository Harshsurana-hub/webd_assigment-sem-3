<div class="page-header">
  <div>
    <h1><i class="fas fa-building"></i> Browse Venues</h1>
    <p class="page-subtitle">Find the perfect venue for your event</p>
  </div>
</div>

<!-- Search & Filter -->
<div class="section-card filter-card">
  <form action="/venues" method="GET" class="filter-form">
    <div class="filter-grid">
      <div class="form-group">
        <label for="name"><i class="fas fa-search"></i> Venue Name</label>
        <input type="text" id="name" name="name" placeholder="Search by name..." value="<%= filters.name || '' %>">
      </div>
      <div class="form-group">
        <label for="capacity"><i class="fas fa-users"></i> Min Capacity</label>
        <input type="number" id="capacity" name="capacity" placeholder="e.g. 100" min="1" value="<%= filters.capacity || '' %>">
      </div>
      <div class="form-group">
        <label for="facility"><i class="fas fa-cogs"></i> Facility</label>
        <select id="facility" name="facility">
          <option value="">All Facilities</option>
          <% allFacilities.forEach(f => { %>
            <option value="<%= f %>" <%= filters.facility === f ? 'selected' : '' %>><%= f %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="maxRate"><i class="fas fa-rupee-sign"></i> Max Rate/hr</label>
        <input type="number" id="maxRate" name="maxRate" placeholder="e.g. 5000" min="0" value="<%= filters.maxRate || '' %>">
      </div>
      <div class="form-group">
        <label for="date"><i class="fas fa-calendar"></i> Date</label>
        <input type="date" id="date" name="date" value="<%= filters.date || '' %>">
      </div>
      <div class="form-group">
        <label for="startTime"><i class="fas fa-clock"></i> Start Time</label>
        <input type="time" id="startTime" name="startTime" value="<%= filters.startTime || '' %>">
      </div>
      <div class="form-group">
        <label for="endTime"><i class="fas fa-clock"></i> End Time</label>
        <input type="time" id="endTime" name="endTime" value="<%= filters.endTime || '' %>">
      </div>
      <div class="form-group filter-actions">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
        <a href="/venues" class="btn btn-outline">Clear</a>
      </div>
    </div>
  </form>
</div>

<!-- Results -->
<% if (venues.length > 0) { %>
  <p class="results-count"><strong><%= venues.length %></strong> venue<%= venues.length !== 1 ? 's' : '' %> found</p>
  <div class="venue-grid">
    <% venues.forEach(venue => { %>
      <div class="venue-card">
        <div class="venue-card-image">
          <img src="<%= venue.imageUrl || '/images/default-venue.jpg' %>" alt="<%= venue.name %>" onerror="this.src='/images/default-venue.jpg'">
          <div class="venue-card-badge">
            <span class="status-badge status-<%= venue.status %>"><%= venue.status %></span>
          </div>
        </div>
        <div class="venue-card-body">
          <h3 class="venue-card-title"><%= venue.name %></h3>
          <p class="venue-card-location"><i class="fas fa-map-marker-alt"></i> <%= venue.location %></p>
          <div class="venue-card-meta">
            <span><i class="fas fa-users"></i> <%= venue.capacity %></span>
            <span class="venue-card-rate">₹<%= venue.hourlyRate.toLocaleString('en-IN') %>/hr</span>
          </div>
          <div class="venue-card-facilities">
            <% venue.facilities.slice(0, 3).forEach(f => { %>
              <span class="facility-tag"><%= f %></span>
            <% }) %>
            <% if (venue.facilities.length > 3) { %>
              <span class="facility-tag facility-more">+<%= venue.facilities.length - 3 %> more</span>
            <% } %>
          </div>
          <a href="/venues/<%= venue._id %>" class="btn btn-primary btn-block">View Details</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="empty-state">
    <i class="fas fa-search"></i>
    <h3>No venues found</h3>
    <p>Try adjusting your search filters or <a href="/venues">browse all venues</a>.</p>
  </div>
<% } %>
