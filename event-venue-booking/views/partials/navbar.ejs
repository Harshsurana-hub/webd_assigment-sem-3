<nav class="navbar" id="main-navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-brand">
      <i class="fas fa-calendar-check"></i>
      <span>EventBook</span>
    </a>

    <button class="navbar-toggle" id="navbar-toggle" aria-label="Toggle navigation">
      <i class="fas fa-bars"></i>
    </button>

    <div class="navbar-menu" id="navbar-menu">
      <% if (isAuthenticated) { %>
        <% if (isOrganiser) { %>
          <a href="/dashboard" class="navbar-link">
            <i class="fas fa-tachometer-alt"></i> Dashboard
          </a>
          <a href="/venues" class="navbar-link">
            <i class="fas fa-building"></i> Venues
          </a>
          <a href="/my-bookings" class="navbar-link">
            <i class="fas fa-ticket-alt"></i> My Bookings
          </a>
        <% } %>
        <% if (isAdmin) { %>
          <a href="/admin/dashboard" class="navbar-link">
            <i class="fas fa-tachometer-alt"></i> Dashboard
          </a>
        <% } %>

        <div class="navbar-user">
          <div class="user-dropdown" id="user-dropdown">
            <button class="user-dropdown-btn" id="user-dropdown-btn">
              <div class="user-avatar">
                <%= currentUser.name ? currentUser.name.charAt(0).toUpperCase() : 'U' %>
              </div>
              <span class="user-name"><%= currentUser.name %></span>
              <i class="fas fa-chevron-down"></i>
            </button>
            <div class="user-dropdown-menu" id="user-dropdown-menu">
              <div class="dropdown-header">
                <strong><%= currentUser.name %></strong>
                <span class="role-badge role-<%= currentUser.role %>"><%= currentUser.role %></span>
              </div>
              <hr class="dropdown-divider">
              <form action="/logout" method="POST">
                <button type="submit" class="dropdown-item logout-btn">
                  <i class="fas fa-sign-out-alt"></i> Logout
                </button>
              </form>
            </div>
          </div>
        </div>
      <% } else { %>
        <a href="/venues" class="navbar-link">
          <i class="fas fa-building"></i> Venues
        </a>
        <a href="/login" class="navbar-link">Login</a>
        <a href="/register" class="btn btn-primary btn-sm">Register</a>
      <% } %>
    </div>
  </div>
</nav>
