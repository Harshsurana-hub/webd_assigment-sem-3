<div class="error-page">
  <div class="error-icon">
    <% if (statusCode === 404) { %>
      <i class="fas fa-map-signs"></i>
    <% } else { %>
      <i class="fas fa-exclamation-triangle"></i>
    <% } %>
  </div>
  <h1><%= statusCode %></h1>
  <h2><%= message %></h2>
  <a href="/" class="btn btn-primary">
    <i class="fas fa-home"></i> Go Home
  </a>
</div>
